{
  "expo": {
    "name": "VocabHighlighter",
    "owner": "shyams-team",
    "slug": "vocabulary-highlighter-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vocabularyhighlighter.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "package": "com.vocabularyhighlighter.mobile"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router"
    ],
    "scheme": "vocabhighlighter",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "eed34a6d-afb6-440a-92cf-37874863ac35"
      }
    }
  }
}
